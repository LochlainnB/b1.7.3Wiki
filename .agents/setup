#!/usr/bin/env bash
set -euo pipefail

repo_root="$(dirname "$(dirname "$(realpath "$0")")")"
cd "$repo_root"

# Match CI's Node 24, including in later agent and service login shells.
node_version=24.21.0
case "$(uname -m)" in
  x86_64) node_arch=x64 ;;
  aarch64) node_arch=arm64 ;;
  *) echo "Unsupported Node architecture: $(uname -m)" >&2; exit 1 ;;
esac
node_dir="/opt/node-v${node_version}-linux-${node_arch}"

scratch="$(mktemp -d)"
trap 'rm -rf "$scratch"' EXIT

if [[ ! -x "$node_dir/bin/node" ]]; then
  echo "Installing Node $node_version"
  curl --fail --location --silent --show-error --retry 3 \
    "https://nodejs.org/dist/v${node_version}/node-v${node_version}-linux-${node_arch}.tar.xz" \
    -o "$scratch/node.tar.xz"
  sudo tar -xJf "$scratch/node.tar.xz" -C /opt
fi
for tool in node npm npx; do
  sudo ln -sfn "$node_dir/bin/$tool" "/usr/local/bin/$tool"
done
echo "Installing wiki dependencies with $(node --version)"
npm ci

# Extract only the source, never the upstream binaries or jars, outside Git.
source_commit=740c583901e1ff1150e9ef37e37dab5bc0e4f807
source_dir="$(dirname "$repo_root")/b1.7.3Source-${source_commit}"
if [[ ! -d "$source_dir" ]]; then
  echo "Downloading pinned Beta 1.7.3 source"
  curl --fail --location --silent --show-error --retry 3 \
    "https://codeload.github.com/jacobo-mc/mc_b1.7.3_release/tar.gz/${source_commit}" \
    -o "$scratch/source.tar.gz"
  mkdir "$scratch/source"
  tar -xzf "$scratch/source.tar.gz" -C "$scratch/source" --strip-components=3 \
    "mc_b1.7.3_release-${source_commit}/1.7.3-LTS/src"
  mv "$scratch/source" "$source_dir"
fi

# Preserve jar/cache settings; B173_SOURCE remains an explicit override.
node --input-type=module - "$source_dir" <<'JS'
import { existsSync, readFileSync, writeFileSync } from 'node:fs';
const file = 'wiki.local.json';
const config = existsSync(file) ? JSON.parse(readFileSync(file, 'utf8')) : {};
config.sourceDir = process.argv[2];
writeFileSync(file, JSON.stringify(config, null, 2) + '\n');
JS

# Install the b1.7.3 harness (https://github.com/LochlainnB/b1.7.3Harness) for
# in-game testing: tick-exact experiments against the real game. Kept as a
# commit-pinned sibling checkout, like the source above, so orbs are
# reproducible; bump harness_commit to pick up harness updates.
harness_commit=df5a794ff71048abccc73262663cd4d2a13efeb8
harness_dir="$(dirname "$repo_root")/b1.7.3Harness"
if [[ ! -d "$harness_dir/.git" ]]; then
  echo "Cloning b1.7.3Harness"
  git clone --quiet https://github.com/LochlainnB/b1.7.3Harness.git "$harness_dir"
fi
git -C "$harness_dir" checkout --quiet "$harness_commit"

# Xvfb and Mesa (llvmpipe) for headless game clients, per the harness README.
system_deps=(xvfb libgl1-mesa-dri libgl1 mesa-utils libxrandr2 libxxf86vm1 libxcursor1 libxi6 libopenal1)
if ! dpkg -s "${system_deps[@]}" >/dev/null 2>&1; then
  echo "Installing harness system dependencies"
  sudo apt-get update -qq
  sudo apt-get install -y -qq "${system_deps[@]}" >/dev/null
fi

# Editable install into the harness checkout's own venv; expose b173 on PATH.
harness_venv="$harness_dir/.venv"
if command -v uv >/dev/null; then
  if [[ ! -x "$harness_venv/bin/python" ]]; then
    uv venv --quiet "$harness_venv"
  fi
  uv pip install --quiet --python "$harness_venv/bin/python" -e "$harness_dir[capture,test]"
else
  python3 -m venv "$harness_venv"
  "$harness_venv/bin/pip" install --quiet -e "$harness_dir[capture,test]"
fi
sudo ln -sfn "$harness_venv/bin/b173" /usr/local/bin/b173

# Downloads JDK 17, the pinned game jars (~500 MB into ~/.cache/b173harness) and
# derives the MCP-named compile jars. Idempotent and hash-checked; a warm run
# verifies what is already cached.
"$harness_venv/bin/b173" setup
"$harness_venv/bin/b173" doctor

npm run check
